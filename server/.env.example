PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ElevenLabs TTS Provider Configuration (Day 10)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
TTS_PROVIDER_TIMEOUT_MS=15000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Authentication & JWT Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Supabase Storage Configuration (Phase 1)
# Backend-only credentials. Never expose to client or commit real keys to git.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=speech-audio
