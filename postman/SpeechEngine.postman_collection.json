{
  "info": {
    "_postman_id": "speechengine-api-collection-v2",
    "name": "text-to-speech",
    "description": "SpeechEngine Backend API Collection including Authentication and Authenticated TTS Persistence.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "User authentication endpoints utilizing HTTP-only JWT cookies.",
      "item": [
        {
          "name": "01 - Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a new user account and returns an HTTP-only JWT session cookie."
          }
        },
        {
          "name": "02 - Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates credentials and establishes HTTP-only session cookie."
          }
        },
        {
          "name": "03 - Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Retrieves the authenticated user profile using the session cookie."
          }
        },
        {
          "name": "04 - Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Clears the authentication session cookie."
          }
        }
      ]
    },
    {
      "name": "TTS",
      "description": "Authenticated Speech Synthesis and Persistence endpoints.",
      "item": [
        {
          "name": "01 - Unauthenticated Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hello from SpeechEngine\",\n  \"language\": \"en-US\",\n  \"voice\": \"sarah\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tts"]
            },
            "description": "Verifies that POST /api/tts strictly rejects unauthenticated requests with HTTP 401 Unauthorized."
          }
        },
        {
          "name": "02 - Authenticated Valid Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "audio/mpeg"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hello from SpeechEngine\",\n  \"language\": \"en-US\",\n  \"voice\": \"sarah\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tts"]
            },
            "description": "Sends authenticated TTS request. Returns raw audio/mpeg and automatically saves metadata row to PostgreSQL speeches table."
          }
        },
        {
          "name": "03 - Invalid Text",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"   \",\n  \"language\": \"en-US\",\n  \"voice\": \"sarah\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tts"]
            },
            "description": "Verifies that empty or whitespace-only text is rejected with HTTP 400 Bad Request."
          }
        },
        {
          "name": "04 - Invalid Language",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hello from SpeechEngine\",\n  \"language\": \"unsupported-lang\",\n  \"voice\": \"sarah\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tts"]
            },
            "description": "Verifies that unsupported language code is rejected with HTTP 400 Bad Request."
          }
        },
        {
          "name": "05 - Invalid Voice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hello from SpeechEngine\",\n  \"language\": \"en-US\",\n  \"voice\": \"invalid-voice\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tts"]
            },
            "description": "Verifies that unknown or incompatible voice is rejected with HTTP 400 Bad Request."
          }
        },
        {
          "name": "06 - Ownership Check",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "audio/mpeg"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Verifying that client-provided user_id is ignored and req.user.id is used.\",\n  \"user_id\": \"00000000-0000-0000-0000-000000000000\",\n  \"userId\": \"11111111-1111-1111-1111-111111111111\",\n  \"language\": \"en-US\",\n  \"voice\": \"sarah\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tts"]
            },
            "description": "Verifies that client-supplied user_id or userId fields are completely ignored and the database record is strictly bound to req.user.id."
          }
        }
      ]
    }
  ]
}
